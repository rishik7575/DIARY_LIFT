rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper to get user profile data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    function isStaffOrAdmin() {
      return isAuthenticated() && (getUserData().role == 'staff' || getUserData().role == 'admin');
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Public Product Catalog
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Cattle Assets & Herd Telemetry
    match /cattle/{cattleId} {
      allow read: if isAuthenticated();
      allow write: if isStaffOrAdmin();
    }

    // Daily Milking Logs
    match /milking_logs/{logId} {
      allow read: if isAuthenticated();
      allow write: if isStaffOrAdmin();
    }

    // Environmental & Veterinary Alerts
    match /sensor_alerts/{alertId} {
      allow read: if isAuthenticated();
      allow write: if isStaffOrAdmin();
    }

    match /veterinary_alerts/{alertId} {
      allow read: if isAuthenticated();
      allow write: if isStaffOrAdmin();
    }

    // Facilities & Threshold Configurations
    match /facilities/{facilityId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Consumer Orders
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.customerId == request.auth.uid || isStaffOrAdmin());
      allow create: if isAuthenticated();
      allow update: if isStaffOrAdmin() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Investor Profiles & Dividends
    match /investors/{investorId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
